# /etc/remarkable-server/env  (root:remarkable 0640)
RMS_BIND=127.0.0.1:3100
RMS_STORAGE=/var/lib/remarkable-server
RUST_LOG=remarkable_server=info

# Admin API token: generate with `openssl rand -hex 32`
ADMIN_TOKEN=CHANGE_ME

# Screenshare broker. MQTT over TLS can't go through nginx's HTTP proxy, so it
# listens on its own port with the Let's Encrypt cert (copied by the certbot hook).
SCREENSHARE_BIND=0.0.0.0:8883
SCREENSHARE_CERT=/etc/remarkable-server/tls/fullchain.pem
SCREENSHARE_KEY=/etc/remarkable-server/tls/privkey.pem
