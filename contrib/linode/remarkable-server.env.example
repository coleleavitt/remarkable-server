# /etc/remarkable-server/env  (root:remarkable 0640)
RMS_BIND=127.0.0.1:3100
RMS_STORAGE=/var/lib/remarkable-server
RUST_LOG=remarkable_server=info

# Public base URL for links a person opens (OAuth verification_uri shown by the
# client). Without it they use https://<--host>, the tablet-internal name.
PUBLIC_URL=https://remarkable.unwrap.rs

# Crash reports from the tablet's crash uploader. The default ./crash-dumps is outside
# ReadWritePaths (ProtectSystem=strict), so writes there fail silently; keep it under storage.
CRASH_DIR=/var/lib/remarkable-server/crash-dumps

# Admin API token: generate with `openssl rand -hex 32`
ADMIN_TOKEN=CHANGE_ME

# Screenshare broker. MQTT over TLS can't go through nginx's HTTP proxy, so it
# listens on its own port with the Let's Encrypt cert (copied by the certbot hook).
SCREENSHARE_BIND=0.0.0.0:8883
SCREENSHARE_CERT=/etc/remarkable-server/tls/fullchain.pem
SCREENSHARE_KEY=/etc/remarkable-server/tls/privkey.pem

# Browser viewer for the tablet's screen share at /screenshare/view (needs
# ADMIN_TOKEN; works with the MQTT broker above and the REST rooms). Allow the
# UDP range through the firewall, e.g. ufw: 50000:50100/udp.
#SCREENSHARE_VIEWER=1
#SCREENSHARE_VIEWER_UDP_PORTS=50000-50100

# MQTT 3.1.1 over WebSocket sync push at /mqtt. Off by default: the tablet only
# uses /notifications/ws/json/1 (see GAP_ANALYSIS.md, "MQTT: what the tablet
# actually uses"). Enable only for a client that needs it.
#MQTT_WS_NOTIFICATIONS=1
