# Environment for contrib/systemd/remarkable-server.service
# Copy to ~/.config/remarkable-server/env and edit. Do not commit real secrets.

# OpenRC only (systemd user unit runs as you): account to run as
#RMS_USER=cole

RMS_BIN=/home/YOU/RustProjects/tools/remarkable-server/target/release/remarkable-server
RMS_BIND=127.0.0.1:8080
RMS_HOST=local.tectonic.remarkable.com
RMS_STORAGE=/home/YOU/RustProjects/tools/remarkable-server/remarkable-storage
RMS_CERT=/home/YOU/RustProjects/tools/remarkable-server/certs/server.crt
RMS_KEY=/home/YOU/RustProjects/tools/remarkable-server/certs/server.key

# Optional features (see README "Optional features")
#JWT_SECRET=
#ADMIN_TOKEN=
#PUBLIC_URL=https://local.tectonic.remarkable.com
#FIRMWARE_ARCHIVE=/path/to/software_archive
#SCREENSHARE_BIND=
#SCREENSHARE_ICE_SERVERS=[]
# /mqtt (MQTT over WebSocket sync push); off by default, the tablet doesn't use it
#MQTT_WS_NOTIFICATIONS=1
#EMAIL_INBOUND_BIND=127.0.0.1:2525
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM=
#HWR_CAPTURE_DIR=
#CRASH_DIR=
#POCKET_CONSUMER_KEY=
#INSTAPAPER_CONSUMER_KEY=
#INSTAPAPER_CONSUMER_SECRET=
